[gcode_macro guardar]
description = Graba datos de ajuste despues de cambiar, por ejemplo el Z-offset
gcode = 
	
	{% if printer.print_stats.state != "printing" %}
	BEEP
	_led_rojo
	M118 Procediendo a grabar los datos de ajuste
	M117 Procediendo a grabar los datos de ajuste
	BEEP
	BEEP
	M118 Grabando ajustes, ahora el sistema se reiniciará.
	M117 Grabando ajustes, ahora el sistema se reiniciará.
	G4 P3000
	SAVE_CONFIG
	
	{% else %}
	
	BEEP
	BEEP
	
	{action_respond_info("No puedes ejecutar la macro de guardado de datos mientras estás imprimiendo")}
	
	{% endif %}

[gcode_button pulsador]
pin = PG13
press_gcode = 
	{% if (printer.print_stats.state != "printing")%}
	_led_rojo
	{% else %}
	M118 La maquina está imprimiendo, ahora no se puede descargar!
	M117 La maquina está imprimiendo, ahora no se puede descargar!
	BEEP
	{% endif %}
release_gcode = 
	{% if (printer.print_stats.state != "printing")%}
	M118 Descargando el filamento!
	M117 Descargando el filamento!
	unload_filament
	{% else %}
	M118 La maquina está imprimiendo, ahora no se puede descargar!
	M117 La maquina está imprimiendo, ahora no se puede descargar!
	BEEP
	BEEP
	BEEP
	{% endif %}

