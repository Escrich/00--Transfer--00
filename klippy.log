	G1 E-1.5 Z0.2 F1250
	G1 X5 Y5 F1250
	G90
	
	
	
	
	
	{% set diferencia_z = (Z_MAX - printer.toolhead.position.z) %}
	{% set ascenso_z = (diferencia_z / 4) %}
