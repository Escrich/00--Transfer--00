[gcode_macro END_PRINT]
description = Macro que será ejecutada al final de una impresión que acabe con normalidad
gcode = 
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	
	{% set diferencia_z = (0)|float %}
	{% set ascenso_z = (0)|float %}
	{% set subida_z = (0)|float %}
	
	
	
	
	_LED_VERDE
	SET_LED LED=tira_led WHITE=0.25
	M400
	BEEP
	
	
	G91
	G1 E-2 F2700
	G1 E-1.5 Z0.2 F1250
	G1 X5 Y5 F1250
	G90
	
	
	
	
	
	{% set diferencia_z = (Z_MAX - printer.toolhead.position.z) %}
	{% set ascenso_z = (diferencia_z / 4) %}
	{% set subida_z = (printer.toolhead.position.z + ascenso_z) %}
	
	
	
	
