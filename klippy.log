	M118
	ECHO_VAR_GLOBALS
	M118
	M118    *************************************
	M118        Listado de parametros
	M118    *************************************
	M118
	DUMP_PARAMETER
	M118
	M118    *************************************
	M118        Limites de impresión
	M118    *************************************
	M118
	DUMP_PRINT_AREA_LIMITS
	M118
	M118    *************************************
	M118        Listado de variables
	M118    *************************************
	M118
	DUMP_VARIABLES
	M118
	M118    *************************************
	M118        M503
	M118    *************************************
	M118
	M503

[gcode_macro END_PRINT]
description = Macro que será ejecutada al final de una impresión que acabe con normalidad
gcode = 
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	
	{% set diferencia_z = (0)|float %}
	{% set ascenso_z = (0)|float %}
	{% set subida_z = (0)|float %}
	
	
	
	
	_LED_VERDE
	SET_LED LED=tira_led WHITE=0.25
	M400
	BEEP
	
	
	G91
	G1 E-2 F2700
	G1 E-1.5 Z0.2 F1250
	G1 X5 Y5 F1250
	G90
	
	
	
	
	
	{% set diferencia_z = (Z_MAX - printer.toolhead.position.z) %}
	{% set ascenso_z = (diferencia_z / 4) %}
	{% set subida_z = (printer.toolhead.position.z + ascenso_z) %}
	
	
	
	
	M400
	M117 ascendiendo a la posición {subida_z} mm. tras acabar de imprimir la pieza
	M118 ascendiendo a la posición {subida_z} mm. tras acabar de imprimir la pieza
	M400
	
	
	G1 Z{subida_z} F600
	M400
	
	
	G1 X{X_MAX - 20} Y{Y_MAX -10} F7200
	M400
	
	
	
	M106 S0
	M104 S0
	M140 S0
	
	
	M84 X Y E
	M107
	
	
	M400
	M300 S440 P200
	m400
	M300 S660 P250
	M400
	M300 S880 P300
	M400
	
	M118 ***************************************
	M118           Impresión terminada
	M118 ***************************************
	
	M117           Impresión terminada
	
	
	M400
	G4 S15
	M400
	
	
	_led_verde_suave
	SET_LED LED=tira_led WHITE=0.5

[firmware_retraction]
retract_length = 0.8
retract_speed = 35.0
unretract_extra_length = 0
unretract_speed = 25.0

