[gcode_macro CANCEL_PRINT]
description = Cancela el actual trabajo de impresión
rename_existing = CANCEL_PRINT_BASE
gcode = 
	LED_WARNING
	TURN_OFF_HEATERS
	CANCEL_PRINT_BASE
	
	
