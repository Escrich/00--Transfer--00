[gcode_macro PAUSE]
description = Pause the actual running print
rename_existing = PAUSE_BASE
gcode = 
	BEEP
	{% if printer.pause_resume.is_paused %}
	{ action_respond_info("Impresora ya estaba en Pausa") }
	{% else %}
	M117 Entrando en modo Pausa
	M118 Entrando en modo Pausa
	BEEP
	M400
	_led_atencion
	
	
	{% set E = printer["gcode_macro PAUSE"].extrude|float %}
	
	
	{% set x_park = printer.toolhead.axis_maximum.x|float - 10.0 %}
	{% set y_park = printer.toolhead.axis_minimum.y|float + 2.0 %}
	
	
	
	{% set max_z = printer.toolhead.axis_maximum.z|default(235)|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	{% set z_safe = 0.0|float %}
	{% set diferencia_park = (0.0)|float %}
	{% set ascenso_park = (0.0)|float %}
	{% set subida_park = (0.0)|float %}
	
	
	
	{% set diferencia_park = (max_z - printer.toolhead.position.z) %}
	{% set ascenso_park = (diferencia_park / 5) %}
	{% set subida_park = (printer.toolhead.position.z + ascenso_park) %}
	{% set z_safe = (subida_park) %}
	
	
	
	
	PAUSE_BASE
	BEEP
	BEEP
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-{E} F2100
	{% else %}
	{action_respond_info("La extrusora no esta suficientemente caliente")}
	{% endif %}
	{% if "xyz" in printer.toolhead.homed_axes %}
	G1 Z{z_safe} F900
	G90
	G1 X{x_park} Y{y_park} F1250
	{% else %}
	{action_respond_info("La impresora no ha hecho 'HOME'")}
	
	{% endif %}
	BEEP
	M400
	
	{% endif %}
variable_extrude = 1.0

