[gcode_macro SHUTDOWN]
description = Apaga el ordenador externo de control
gcode = 
	{action_call_remote_method("shutdown_machine")}

[gcode_macro REBOOT]
description = Reinicia el ordenador externo de control
gcode = 
	{action_call_remote_method("reboot_machine")}

[gcode_macro FILAMENT_CHANGE]
description = Cambio de filamento, mediante el procedimiento de PAUSE
gcode = 
	SET_LED LED=tira_led WHITE=0.5
	PAUSE
	
	
	M117 Descargando automaticamente el filamento
	M118 Descargando automaticamente el filamento
	BEEP
	M400
	SET_LED LED=tira_led WHITE=0.5

[gcode_macro LOAD_FILAMENT]
description = Carga de filamento via macro o pulsador
gcode = 
	SET_LED LED=tira_led WHITE=0.5
	{% if printer.extruder.can_extrude|lower == 'true' %}
	_SAFE_TEMP_FILAMENT
	_LOAD_FILAMENT
	
	SET_LED LED=tira_led WHITE=0.5
	{% else %}
	_LED_AZUL
	_TEMP_EXTRUDER
	_LOAD_FILAMENT
	
	SET_LED LED=tira_led WHITE=0.5
	{% endif %}
	BEEP
	M400
	BEEP
	M400
	SET_LED LED=tira_led WHITE=0.5

[gcode_macro UNLOAD_FILAMENT]
description = Descarga de filamento via macro o pulsador
gcode = 
	SET_LED LED=tira_led WHITE=0.5
	M400
	{% if printer.extruder.can_extrude|lower == 'true' %}
	_SAFE_TEMP_FILAMENT
	_UNLOAD_FILAMENT
	{% else %}
	_LED_AZUL
	_TEMP_EXTRUDER
	_UNLOAD_FILAMENT
	_led_atencion
	SET_LED LED=tira_led WHITE=0.5
	{% endif %}
	BEEP
	BEEP
	M400
	SET_LED LED=tira_led WHITE=0.5
	BEEP

[gcode_macro _LOAD_FILAMENT]
gcode = 
	{% if printer.extruder.can_extrude|lower == 'true' %}
	{% set vg = printer["gcode_macro VAR_GLOBALS"] %}
	SAVE_GCODE_STATE NAME=LOAD_state
	
	BEEP
	M118 Cargando filamento...
	M117 Cargando filamento...
	M83
	{% for r in range(vg.fil_num_repeats) %}
	
	G1 E{vg.fil_length_load} F{vg.fil_speed}
	{% endfor %}
	
	BEEP
	M118 Filamento cargado.
	M117 Filamento cargado.
	_LED_PRINTING
	RESTORE_GCODE_STATE NAME=LOAD_state
	BEEP
	BEEP
	M400
	{% else %}
	_LED_AZUL
	M118 Temperatura baja, imposible retraer el filamento
	M117 Temperatura baja, imposible retraer el filamento
	BEEP
	BEEP
	BEEP
	M400
	{% endif %}
	SET_LED LED=tira_led WHITE=0.5

[gcode_macro _UNLOAD_FILAMENT]
gcode = 
	{% if printer.extruder.can_extrude|lower == 'true' %}
	{% set vg = printer["gcode_macro VAR_GLOBALS"] %}
	SAVE_GCODE_STATE NAME=UNLOAD_state
	SET_LED LED=tira_led WHITE=0.5
	BEEP
	M118 Descargando filamento...
	M117 Descargando filamento...
	M83
	G1 E{vg.fil_extra_output} F{vg.fil_extra_speed }
	G1 E{vg.fil_length_purge} F{vg.fil_purge_speed}
	G1 E-{vg.unload_retract_length} F{vg.unload_retract_speed}
	G4 P250
	G1 E-{vg.fil_length_unload/5} F{vg.fil_speed}
	{% for r in range(vg.fil_num_repeats) %}
	G1 E-{vg.fil_length_unload} F{vg.fil_fast_speed}
	{% endfor %}
	
	M118 Filamento descargado.
	M117 Filamento descargado.
	RESTORE_GCODE_STATE NAME=UNLOAD_state
	_led_atencion
	SET_LED LED=tira_led WHITE=0.5
	BEEP
	BEEP
	M400
	{% else %}
	M118 Temperatura baja, imposible retraer el filamento.
	M117 Temperatura baja, imposible retraer el filamento.
	_LED_AZUL
	BEEP
	BEEP
	BEEP
	M400
	{% endif %}
	SET_LED LED=tira_led WHITE=0.5
	BEEP

[gcode_macro _TEMP_EXTRUDER]
gcode = 
	{% if printer.extruder.can_extrude|lower == 'false' %}
	{% set vg = printer["gcode_macro VAR_GLOBALS"] %}
	{% set t_extruder = vg.temp_extruder %}
	BEEP
	M118 Temperatura baja, calentando y esperando a temperatura objetivo.
	M117 Temperatura baja, calentando y esperando a temperatura objetivo.
	_LED_AZUL
	M109 S{t_extruder}
	_LED_PRINTING
	SET_LED LED=tira_led WHITE=0.5
	{% endif %}

[gcode_macro _SAFE_TEMP_FILAMENT]
description = Aseguramiento de temperatura para movimientos de carga o descarga del filamento
gcode = 
	{% set vg = printer["gcode_macro VAR_GLOBALS"] %}
	{% set limite_inferior = vg.temp_extruder %}
	{% set current_sp = printer.extruder.target %}
	M118 Ejecutando aseguramiento de temperatura
	M117 Ejecutando aseguramiento de temperatura
	M118 Setpoint actual extrusora: { "%.1f"|format(printer.extruder.target) } °C
	M117 Setpoint actual extrusora: { "%.1f"|format(printer.extruder.target) } °C
	
	
	{% if printer.print_stats.state != "printing" and printer.print_stats.state != "paused" %}
	{% if current_sp < limite_inferior %}
	{% set t_extruder = vg.temp_extruder %}
	M104 S{t_extruder}
	
	M118 Nueva temperatura por setpoint bajo {t_extruder} °C
	M117 Nueva temperatura por setpoint bajo {t_extruder} °C
	{% endif %}
	M118 Establecida temperatura para cargar o descargar con seguridad.
	M117 Establecida temperatura para cargar o descargar con seguridad.
	{% else %}
	M117 Imprimiendo o en Pausa, no se aplican cambios de temperatura.
	M118 Imprimiendo o en Pausa, no se aplican cambios de temperatura.
	{% endif %}

[gcode_macro CENTRADO]
description = Centra la cama y pone la boquilla en alto, para tareas de mantenimiento o de producción, siempre que no estemos imprimiendo
gcode = 
	
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	{% set X_centro = X_MAX/2 %}
	
	{% set Y_centro = 117.5 %}
	{% set Z_altura = 70 %}
	
	
	{% if printer.print_stats.state != "printing" %}
	{% if "xyz" in printer.toolhead.homed_axes %}
	{action_respond_info("La Impresora ya habia hecho home previamente")}
	{action_respond_info("Por tanto vamos directamente a la posición de centrado")}
	BEEP
	G90
	M201 X3000 Y3000
	G1 X{X_centro} Y{Y_centro} Z{Z_altura} F20000
	
	{% else %}
	{action_respond_info("La Impresora no habia hecho 'home' desde el ultimo reinicio")}
	{action_respond_info("Por lo que primero haremos Home")}
	{action_respond_info("Y a continuación iremos a la posición de centrado")}
	BEEP
	G90
	G28
	M201 X3000 Y3000
	G1 X{X_centro} Y{Y_centro} Z{Z_altura} F20000
	{% endif %}
	
	{% else %}
	
	BEEP
	BEEP
	{action_respond_info("No puedes ejecutar la macro de centrado mientras estás imprimiendo")}
	
	{% endif %}

[gcode_macro _CENTRADO_BAJO]
description = Centra la cama y pone la boquilla a una altura de solo 15 mm., para tareas de mantenimiento o de producción, siempre que no estemos imprimiendo
gcode = 
	
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	{% set X_centro = X_MAX/2 %}
	{% set Y_centro = Y_MAX/2 %}
	{% set Z_altura = 15 %}
	
	
	{% if printer.print_stats.state != "printing" %}
	{% if "xyz" in printer.toolhead.homed_axes %}
	{action_respond_info("La Impresora ya habia hecho home previamente")}
	{action_respond_info("Por tanto vamos directamente a la posición de centrado")}
	BEEP
	G90
	M201 X3000 Y3000
	G1 X{X_centro} Y{Y_centro} Z{Z_altura} F20000
	
	{% else %}
	{action_respond_info("La Impresora no habia hecho home previamente")}
	{action_respond_info("Por lo que primero haremos Home")}
	{action_respond_info("Y a continuación iremos a la posición de centrado")}
	BEEP
	G90
	G28
	M201 X3000 Y3000
	G1 X{X_centro} Y{Y_centro} Z{Z_altura} F20000
	{% endif %}
	
	{% else %}
	
	_led_amarillo
	BEEP
	BEEP
	{action_respond_info("No puedes ejecutar la macro de centrado mientras estás imprimiendo")}
	
	{% endif %}

[gcode_macro debug]
description = Macro para ver valores y buscar fallos, añade aquí las variables que necesites ver en cualquier momento
gcode = 
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	
	M118 Altura al acabar la pieza {printer.toolhead.position.z}
	M400
	{% if printer.toolhead.position.z < (Z_MAX - 10) %}
	M118 hay espacio, luego subo
	G1 Z{printer.toolhead.position.z + 10} F600
	M118 Altura al acabar el proceso {printer.toolhead.position.z}
	M400
	{% endif %}
	
	M400
	M118 Altura al acabar el proceso {printer.toolhead.position.z}

[gcode_macro DUMP_PARAMETER]
description = Debug: Muestra toda la información posible sobre la maquina y el entorno de impresión.
gcode = 
	
	
	
	
	
	{% set config = True if params.C or params.S else False %}
	{% set path = 'config'   if params.C
	else 'settings' if params.S %}
	{% set search = params.C if params.C
	else params.S if params.S
	else params.P if params.P %}
	{% set out = [] %}
	{% for name1 in printer|sort %}
	{% if config %}
	{% if name1 is in ['configfile'] %}
	{% for name2 in printer[name1][path]|sort %}
	{% if name2 is in [search] %}
	{% for name3, value in printer[name1][path][name2].items()|sort %}
	{% set _dummy = out.append("printer.configfile.%s.%s.%s = %s" %
	(path, name2, name3, value)) %}  Aqui
	{% endfor %}
	{% endif %}
	{% endfor %}
	{% endif %}
	{% else %}
	{% for name2, value in printer[name1].items()|sort %}
	{% if search is not defined and name1 is not in ['configfile'] %}
	{% set _dummy = out.append("printer.%s.%s = %s" % (name1, name2, value)) %}
	{% elif search is defined and name1 is in [search] %}
	{% set _dummy = out.append("printer.%s.%s = %s" % (name1, name2, value)) %}
	{% endif %}
	{% endfor %}
	{% endif %}
	{% endfor %}
	{% if out|length > 0 %}
	{action_respond_info(out|join("\n"))}
	{% else %}
	{action_respond_info("Nothing found for \"DUMP_PARAMETER %s\"" % rawparams)}
	{% endif %}

[gcode_macro DUMP_PRINT_AREA_LIMITS]
description = Muestra información acerca del volumen imprimible, y las zonas que serán medidas en el inicio.
gcode = 
	
	
	
	
	
	{% set min = printer.toolhead.axis_minimum %}
	{% set max = printer.toolhead.axis_maximum %}
	{% set probe_offset = {'x' : printer.configfile.settings.probe.x_offset,
	'y' : printer.configfile.settings.probe.y_offset} %}
	{% set probe_area = {'min' : {'x' : [min.x,(min.x-probe_offset.x)]|max,
	'y' : [min.y,(min.y-probe_offset.y)]|max},
	'max' : {'x' : [max.x,(max.x-probe_offset.x)]|min,
	'y' : [max.y,(max.y-probe_offset.y)]|min}} %}
	{action_respond_info("Print Volume Limits:
	Min X:%7.1f, Y:%7.1f, Z:%7.1f
	Max X:%7.1f, Y:%7.1f, Z:%7.1f
	Probe Area Limits:
	Min X:%7.1f, Y:%7.1f
	Max X:%7.1f, Y:%7.1f" %
	(min.x,min.y,min.z,max.x,max.y,max.z,probe_area.min.x,probe_area.min.y, probe_area.max.x,probe_area.max.y))}

[gcode_macro DUMP_VARIABLES]
description = Volcado de variables
gcode = 
	
	
	
	
	
	{% set filter_name = params.NAME|default('')|string|lower %}
	{% set filter_value = params.VALUE|default('')|string|lower %}
	{% set show_cfg = params.SHOW_CFG|default(1)|int %}
	
	{% set out = [] %}
	
	{% for key1 in printer %}
	{% for key2 in printer[key1] %}
	{% if (show_cfg or not (key1|lower == 'configfile' and key2|lower in ['config', 'settings'])) and (filter_name in key1|lower or filter_name in key2|lower) and filter_value in printer[key1][key2]|string|lower %}
	{% set dummy = out.append("printer['%s'].%s = %s" % (key1, key2, printer[key1][key2])) %}
	{% endif %}
	{% else %}
	{% if filter_name in key1|lower and filter_value in printer[key1]|string|lower %}
	{% set dummy = out.append("printer['%s'] = %s" % (key1, printer[key1])) %}
	{% endif %}
	{% endfor %}
	{% endfor %}
	
	{action_respond_info(out|join("\n"))}

