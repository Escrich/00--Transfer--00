[gcode_macro M115]
description = Print host and mcu version
rename_existing = M115.1
gcode = 
	{% set out = ['mcu build version:'] %}
	{% for name1 in printer %}
	{% for name2 in printer[name1] %}
	{% if name2 is in ['mcu_version'] %}
	{% set _dummy = out.append("%s: %s" % (name1, printer[name1][name2])) %}
	{% endif %}
	{% endfor %}
	{% endfor %}
	{action_respond_info(out|join("\n"))}
	M115.1

[gcode_macro M207]
description = Gcode para pasar parametros de retracción a Firmware retract
variable_z_hop = 0.4
gcode = 
	{% if 'S' in params %}
	SET_RETRACTION RETRACT_LENGTH={params.S}
	{% endif %}
	
	{% if 'F' in params %}
	SET_RETRACTION RETRACT_SPEED={params.F|float / 60}
	{% endif %}
	
	{% if 'Z' in params %}
	SET_GCODE_VARIABLE MACRO=M207 VARIABLE=z_hop VALUE={params.Z}
	{% endif %}

[gcode_macro M208]
description = Gcode para pasar parametros de de-retracción a Firmware retract
gcode = 
	{% if 'S' in params %}
	SET_RETRACTION UNRETRACT_EXTRA_LENGTH={params.S}
	{% endif %}
	
	{% if 'F' in params %}
	SET_RETRACTION UNRETRACT_SPEED={params.F|float / 60}
	{% endif %}

[gcode_macro M300]
description = Gcode para generar sonidos en el altavoz
gcode = 
	
	{% set S = params.S|default(880)|int %}
	
	{% set P = params.P|default(300)|int %}
	SET_PIN PIN=BEEPER_pin VALUE=0.5 CYCLE_TIME={ 1.0/S if S > 0 else 1 }
	
	
	SET_PIN PIN=BEEPER_pin VALUE=0

