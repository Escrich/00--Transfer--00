[gcode_macro START_PRINT]
description = Arranca el proceso de impresión
gcode = 
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	
	
	{% set BED_TEMP = params.BED_TEMP|default(60)|float %}
	{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(205)|float %}
	
	
	M104 S{EXTRUDER_TEMP} T0
	M140 S{BED_TEMP}
	
	
	M118 ***************************************
	M118           Empieza la Impresión
	M118 ***************************************
	
	M117           Empieza la Impresión
	
	
	BEEP
	G90
	G28
	
	
	G1 X{X_MAX/2.0} Y{Y_MAX - 20} Z{100} F6000
	
	
	
	_LED_AZUL
	M118 Esperando la temperatura correcta, calentando
	M117 Esperando la temperatura correcta, calentando
	M190 S{BED_TEMP}
	M109 S{EXTRUDER_TEMP} T0
	M118 Temperatura de trabajo alcanzada
	M117 Temperatura de trabajo alcanzada
	_led_atencion
	
	
	M83
	G1 E-2 F300
	
	
	M118 Inicializando posiciónamiento 'HOME'
	M117 Inicializando posiciónamiento 'HOME'
	BEEP
	G90
	G28
	M118 Posiciónamiento 'HOME' Terminado
	M117 Posiciónamiento 'HOME' Terminado
	G4 P500
	
	
	M118 Ajustando simetria en motores eje Z
	M117 Ajustando simetria en motores eje Z
	_LED_ROJO
	_LED_ABAJO
	Z_TILT_ADJUST
	M118 Simetria ajustada
	M117 Simetria ajustada
	
	
	M118 Creando malla de nivelacion
	M117 Creando malla de nivelacion
	
	BED_MESH_CALIBRATE
	
	M118 Malla creada
	M117 Malla creada
	
	_led_atencion
	
	
	G90
	G1 X5 Y0 Z10 F6000
	
	_LED_EXTREMOS
	
	
	M83
	G1 E3 F300
	G90
	
	
	M118 Haciendo lineas de purga
	M117 Haciendo lineas de purga
	
	SET_LED LED=tira_led WHITE=0.15
	
	
	G92 E0
	G1 X10 Y1.0 Z0.28 F2000
	G1 X{printer.toolhead.axis_maximum.x -10} Y1.0 Z0.28 E25 F1000
	G92 E0
	G1 Z5
	
	
	G1 X10 Y2.50 Z5 F2000
	G1 X10 Y2.50 Z0.28 F2000
	G1 X{printer.toolhead.axis_maximum.x -10} Y2.50 Z0.28 E25 F1000
	G92 E0
	
	
	G1 Z5
	G1 E-0.5 F300
	G92 E0
	G90
	
	
	M118 Imprimiendo
	M117 Imprimiendo
	
	
	_led_rainbow

[idle_timeout]
gcode = 
	M118 Limite de tiempo sin actividad alcanzado!
	M117 Limite de tiempo sin actividad alcanzado!
	TURN_OFF_HEATERS
	
	M84 X Y Z E
	M107
	
	beep
	beep
	
	_led_timeout
	M118 Entrando en modo hibernación!
	M117 Entrando en modo hibernación!
	M400
	M81
timeout = 3600

[gcode_macro VAR_GLOBALS]
description = Definición inicial de todas las variables usadas en el proceso de impresión
variable_temp_extruder = 225.0
variable_unload_retract_length = 5.0
variable_unload_retract_speed = 180
variable_fil_length_purge = 1.0
variable_fil_purge_speed = 250
variable_fil_num_repeats = 1
variable_fil_length_load = 220
variable_fil_length_unload = 120
variable_fil_speed = 250
variable_fil_fast_speed = 300
variable_fil_extra_output = 4.0
variable_fil_extra_speed = 100
gcode = 
	BEEP
	M400
	BEEP
	M400
	SET_IDLE_TIMEOUT TIMEOUT=1800
	
	
	
	
	
	_led_atencion
	ECHO_VAR_GLOBALS
	M400
	BEEP
	M400

[gcode_macro ECHO_VAR_GLOBALS]
description = Muestra las variables definidas en VAR_GLOBALS por la pantalla del terminal.
gcode = 
	{% for var, value in printer["gcode_macro VAR_GLOBALS"].items() %}
	{action_respond_info(var ~ ": " ~ value)}
	{% endfor %}

[z_tilt]
z_positions = 
	-65,117.5
	300.0,117.5
points = 
	35,107.5
	35,117.5
	35,127.5
	233,127.5
	233,117.5
	233,107.5
speed = 100
horizontal_move_z = 3
retries = 3
retry_tolerance = 0.8

[gcode_macro G28]
description = Cambia el gcode original G28, auto home, y le añade sonidos y efectos luminosos
rename_existing = G28.1
gcode = 
	{% set ejes = params %}
	BEEP
	led_warning
	
	G28.1 AXIS={ejes}
