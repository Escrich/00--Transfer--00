description = Bed leveling, not in use
gcode = 

[gcode_macro M900]
description = Linear Advance Factor, not in use
gcode = 

[led nombre_led]
red_pin = PB10
cycle_time = 0.010
initial_red = 1.0

[led tira_led]
white_pin = PA3
cycle_time = 0.010
initial_white = 0.6

[neopixel phoenix_led]
