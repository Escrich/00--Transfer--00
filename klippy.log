gcode = 
	M118
	M118    *************************************
	M118        Variables de usuario
	M118    *************************************
	M118
	ECHO_VAR_GLOBALS
	M118
	M118    *************************************
	M118        Listado de parametros
	M118    *************************************
	M118
	DUMP_PARAMETER
	M118
	M118    *************************************
	M118        Limites de impresión
