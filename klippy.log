	M400
	
	
	
	M106 S0
	M104 S0
	M140 S0
	
	
	M84 X Y E
	M107
	
	
	M400
	M300 S440 P200
	m400
	M300 S660 P250
	M400
	M300 S880 P300
	M400
	
	M118 ***************************************
	M118           Impresión terminada
	M118 ***************************************
	
	M117           Impresión terminada
	
	
	M400
	G4 S15
	M400
	
	
	_led_verde_suave
	SET_LED LED=tira_led WHITE=0.5

