[gcode_macro VAR_GLOBALS]
description = Definición inicial de todas las variables usadas en el proceso de impresión
variable_temp_extruder = 225.0
variable_unload_retract_length = 5.0
variable_unload_retract_speed = 180
variable_fil_length_purge = 1.0
variable_fil_purge_speed = 250
variable_fil_num_repeats = 1
variable_fil_length_load = 220
variable_fil_length_unload = 120
variable_fil_speed = 250
variable_fil_fast_speed = 300
variable_fil_extra_output = 4.0
variable_fil_extra_speed = 100
gcode = 
	BEEP
	M400
	BEEP
	M400
	SET_IDLE_TIMEOUT TIMEOUT=1800
	
	
	
	
	
	_led_atencion
	ECHO_VAR_GLOBALS
	M400
	BEEP
	M400

[gcode_macro ECHO_VAR_GLOBALS]
description = Muestra las variables definidas en VAR_GLOBALS por la pantalla del terminal.
