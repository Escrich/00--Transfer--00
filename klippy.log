	{% set indice = 1  %}
	
	BEEP
	
	{% for indice in range(8) %}
	{% set rojo = (range(1,10) | random)/10 %}
	{% set verde = (range(1,10) | random)/10 %}
	{% set azul = (range(1,10) | random)/10 %}
	
	
	{% set indice = (1+indice) %}
	SET_LED LED=phoenix_led RED={rojo}  GREEN={verde}  BLUE={azul}  INDEX={indice}
	
	{% endfor %}

