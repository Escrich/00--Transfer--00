	SET_LED LED=tira_led WHITE=0.5
	M400
	{% if printer.extruder.can_extrude|lower == 'true' %}
	_SAFE_TEMP_FILAMENT
	_UNLOAD_FILAMENT
	{% else %}
	_LED_AZUL
	_TEMP_EXTRUDER
	_UNLOAD_FILAMENT
	_led_atencion
