gcode = 
	
	{% set X_MAX = printer.toolhead.axis_maximum.x|default(235)|float %}
	{% set Y_MAX = printer.toolhead.axis_maximum.y|default(235)|float %}
	{% set Z_MAX = printer.toolhead.axis_maximum.z|default(235)|float %}
	
	
	
	{% set BED_TEMP = params.BED_TEMP|default(60)|float %}
	{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(205)|float %}
	
	
	M104 S{EXTRUDER_TEMP} T0
	M140 S{BED_TEMP}
	
	
	M118 ***************************************
	M118           Empieza la Impresión
	M118 ***************************************
	
	M117           Empieza la Impresión
	
	
	BEEP
	G90
	G28
	
	
	G1 X{X_MAX/2.0} Y{Y_MAX - 20} Z{100} F6000
	
	
	
	_LED_AZUL
	M118 Esperando la temperatura correcta, calentando
	M117 Esperando la temperatura correcta, calentando
	M190 S{BED_TEMP}
	M109 S{EXTRUDER_TEMP} T0
	M118 Temperatura de trabajo alcanzada
	M117 Temperatura de trabajo alcanzada
	_led_atencion
	
	
	M83
	G1 E-2 F300
	
	
	M118 Inicializando posiciónamiento 'HOME'
	M117 Inicializando posiciónamiento 'HOME'
	BEEP
	G90
	G28
	M118 Posiciónamiento 'HOME' Terminado
	M117 Posiciónamiento 'HOME' Terminado
	G4 P500
	
	
	M118 Ajustando simetria en motores eje Z
	M117 Ajustando simetria en motores eje Z
	_LED_ROJO
	_LED_ABAJO
	Z_TILT_ADJUST
	M118 Simetria ajustada
	M117 Simetria ajustada
	
	
	M118 Creando malla de nivelacion
	M117 Creando malla de nivelacion
	
	BED_MESH_CALIBRATE
	
	M118 Malla creada
	M117 Malla creada
	
	_led_atencion
	
	
	G90
	G1 X5 Y0 Z10 F6000
	
	_LED_EXTREMOS
	
	
	M83
	G1 E3 F300
	G90
	
	
	M118 Haciendo lineas de purga
	M117 Haciendo lineas de purga
	
	SET_LED LED=tira_led WHITE=0.15
	
	
	G92 E0
	G1 X10 Y1.0 Z0.28 F2000
	G1 X{printer.toolhead.axis_maximum.x -10} Y1.0 Z0.28 E25 F1000
	G92 E0
	G1 Z5
	
	
	G1 X10 Y2.50 Z5 F2000
	G1 X10 Y2.50 Z0.28 F2000
	G1 X{printer.toolhead.axis_maximum.x -10} Y2.50 Z0.28 E25 F1000
	G92 E0
	
	
	G1 Z5
	G1 E-0.5 F300
	G92 E0
	G90
	
	
	M118 Imprimiendo
	M117 Imprimiendo
	
	
	_led_rainbow

[idle_timeout]
gcode = 
	M118 Limite de tiempo sin actividad alcanzado!
	M117 Limite de tiempo sin actividad alcanzado!
	TURN_OFF_HEATERS
	
	M84 X Y Z E
	M107
	
	beep
	beep
	
	_led_timeout
	M118 Entrando en modo hibernación!
	M117 Entrando en modo hibernación!
	M400
	M81
timeout = 3600

[gcode_macro VAR_GLOBALS]
description = Definición inicial de todas las variables usadas en el proceso de impresión
variable_temp_extruder = 225.0
variable_unload_retract_length = 5.0
variable_unload_retract_speed = 180
variable_fil_length_purge = 1.0
variable_fil_purge_speed = 250
variable_fil_num_repeats = 1
variable_fil_length_load = 220
variable_fil_length_unload = 120
variable_fil_speed = 250
variable_fil_fast_speed = 300
variable_fil_extra_output = 4.0
variable_fil_extra_speed = 100
gcode = 
	BEEP
	M400
	BEEP
	M400
	SET_IDLE_TIMEOUT TIMEOUT=1800
	
	
	
	
	
	_led_atencion
	ECHO_VAR_GLOBALS
	M400
	BEEP
	M400

[gcode_macro ECHO_VAR_GLOBALS]
description = Muestra las variables definidas en VAR_GLOBALS por la pantalla del terminal.
gcode = 
	{% for var, value in printer["gcode_macro VAR_GLOBALS"].items() %}
	{action_respond_info(var ~ ": " ~ value)}
	{% endfor %}

[z_tilt]
z_positions = 
	-65,117.5
	300.0,117.5
points = 
	35,107.5
	35,117.5
	35,127.5
	233,127.5
	233,117.5
	233,107.5
speed = 100
horizontal_move_z = 3
retries = 3
retry_tolerance = 0.8

[gcode_macro G28]
description = Cambia el gcode original G28, auto home, y le añade sonidos y efectos luminosos
rename_existing = G28.1
gcode = 
	{% set ejes = params %}
	BEEP
	led_warning
	
	G28.1 AXIS={ejes}
	_led_verde

[gcode_macro M115]
description = Print host and mcu version
rename_existing = M115.1
gcode = 
	{% set out = ['mcu build version:'] %}
	{% for name1 in printer %}
	{% for name2 in printer[name1] %}
	{% if name2 is in ['mcu_version'] %}
	{% set _dummy = out.append("%s: %s" % (name1, printer[name1][name2])) %}
	{% endif %}
	{% endfor %}
	{% endfor %}
	{action_respond_info(out|join("\n"))}
	M115.1

[gcode_macro M207]
description = Gcode para pasar parametros de retracción a Firmware retract
variable_z_hop = 0.4
gcode = 
	{% if 'S' in params %}
	SET_RETRACTION RETRACT_LENGTH={params.S}
	{% endif %}
	
	{% if 'F' in params %}
	SET_RETRACTION RETRACT_SPEED={params.F|float / 60}
	{% endif %}
	
	{% if 'Z' in params %}
	SET_GCODE_VARIABLE MACRO=M207 VARIABLE=z_hop VALUE={params.Z}
	{% endif %}

[gcode_macro M208]
description = Gcode para pasar parametros de de-retracción a Firmware retract
gcode = 
	{% if 'S' in params %}
	SET_RETRACTION UNRETRACT_EXTRA_LENGTH={params.S}
	{% endif %}
	
	{% if 'F' in params %}
	SET_RETRACTION UNRETRACT_SPEED={params.F|float / 60}
	{% endif %}

[gcode_macro M300]
description = Gcode para generar sonidos en el altavoz
gcode = 
	
	{% set S = params.S|default(880)|int %}
	
	{% set P = params.P|default(300)|int %}
	SET_PIN PIN=BEEPER_pin VALUE=0.5 CYCLE_TIME={ 1.0/S if S > 0 else 1 }
	
	
	SET_PIN PIN=BEEPER_pin VALUE=0

[gcode_macro M503]
description = Muestra los parametros mas importantes de la impresora
gcode = 
	BEEP
	
	M118
	M118    *************************************
	M118        Parametros criticos
	M118    *************************************
	M118 Máxima velocidad {printer["toolhead"].max_velocity}
	M118 Máxima aceleración {printer["toolhead"].max_accel}
	M118 Máxima aceleración a deceleración {printer["toolhead"].max_accel_to_decel}
	M118 Máxima longitud X {printer["toolhead"].axis_maximum.x}
	M118 Máxima longitud Y {printer["toolhead"].axis_maximum.y}
	M118 Máxima altura Z {printer["toolhead"].axis_maximum.z}
	M118 Square corner velocity {printer["toolhead"].square_corner_velocity}
	M118 Pressure advance {printer["extruder"].pressure_advance}
	M118 Smooth time {printer["extruder"].smooth_time}
	
	
	
	
	M118 Longitud purga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_length_purge}
	M118 Velocidad purga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_purge_speed}
	M118 Longitud carga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_length_load}
	M118 Longitud descarga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_length_unload}
	M118 Velocidad carga y descarga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_speed}
	M118 Velocidad rápida de carga y descarga de filamento {printer["gcode_macro VAR_GLOBALS"].fil_fast_speed}
	M118 Variable filamento descargado {printer["gcode_macro VAR_GLOBALS"].filamento_descargado}
	M118 Temperatura minima de impresión {printer["gcode_macro VAR_GLOBALS"].temp_extruder}
	M118 Longitud de retraccion por firmware {printer.firmware_retraction.retract_length}
	M118 Velocidad de retraccion por firmware {printer.firmware_retraction.retract_speed}
	
	
	_led_atencion

[gcode_macro M600]
description = Gcode para manejo del cambio de color
gcode = 
	_LED_ROJO
	
	PAUSE
	BEEP
	BEEP
	
	BEEP
	M118 Empieza el cambio de color automatico o cambio de filamento simple
	M117 Empieza el cambio de color automatico o cambio de filamento simple
	BEEP
	BEEP
	M118 Cambio de color o cambio de filamento ejecutandose
	M117 Cambio de color o cambio de filamento ejecutandose
	
	
	M118 Pulsa el boton del sensor para descargar
	M117 Pulsa el boton del sensor para descargar

[gcode_macro M601]
description = Genera una pausa
gcode = 
	PAUSE

[gcode_button POWER_LOSS_PIN]
pin = PC0
press_gcode = 
	M118 Atención, caida de tension de alimentacion!
	M117 Atención, caida de tension de alimentacion!
	beep
	beep
	beep
release_gcode = 
	M118 La tension de alimentacion ha vuelto y es correcta!
	M117 La tension de alimentacion ha vuelto y es correcta!
	beep
	beep

[output_pin PS_OFF_PIN]
pin = PE11

[gcode_macro M80]
description = Actua sobre la fuente de alimentación conectandola si está apagada, de dudoso uso
gcode = SET_PIN PIN=PS_OFF_PIN VALUE=1
	beep
	M118 Hola, he vuelto a la vida!
	M118 Hola, he vuelto a la vida!
	_led_atencion

[gcode_macro M81]
description = Actua sobre la fuente de alimentación desconectandola, si la extrusora está fria, o enfriandola primero si es necesario
gcode = 
	M118 Procediendo a desconectar la alimentación!
	M117 Procediendo a desconectar la alimentación!
	TURN_OFF_HEATERS
	M84 X Y Z E
	M107
	_led_timeout
	beep
	beep
	TEMPERATURE_WAIT sensor=extruder maximum=50
	
	
	M118 Hasta pronto!
	M117 Hasta pronto!
	led_apagar
	M400
	G4 S3
	SET_LED LED=nombre_led RED=0.8
	SET_PIN PIN=PS_OFF_PIN VALUE=0
	SHUTDOWN

[gcode_macro apagado]
description = Apaga la maquina completamente via M81
gcode = 
	M400
	M81

[gcode_macro M84]
description = Cambia el gcode original M84, desconexión de motores, y le añade sonidos y efectos luminosos
rename_existing = M84.1
gcode = 
	BEEP
	M84.1
	_led_atencion

[gcode_macro TURN_OFF_MOTORS]
description = Macro que para todos los motores paso a paso, pero no para los ventiladores
gcode = 
	M84

[gcode_macro M201]
description = Set max acceleration
gcode = 
	
	
	
	{% if 'X' in params or 'Y' in params %}
	{% set accel = (params.X|default(params.Y)|float,
	params.Y|default(params.X)|float)|min %}
	SET_VELOCITY_LIMIT ACCEL={accel} ACCEL_TO_DECEL={accel * 0.5}
	{% else %}
	SET_VELOCITY_LIMIT
	{% endif %}

[gcode_macro M203]
description = Set max feedrate
gcode = 
	
	
	
	{% if 'X' in params or 'Y' in params %}
	{% set speed = (params.X|default(params.Y)|float,
	params.Y|default(params.X)|float)|min %}
	SET_VELOCITY_LIMIT VELOCITY={speed}
	{% else %}
	SET_VELOCITY_LIMIT
	{% endif %}

[gcode_macro M205]
description = Set Advanced Settings
gcode = 
	
	
	
	{% if 'X' in params or 'Y' in params %}
	{% set corner_speed = (params.X|default(params.Y)|float,
	params.Y|default(params.X)|float)|min %}
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY={corner_speed}
	{% else %}
	SET_VELOCITY_LIMIT
	{% endif %}

[gcode_macro G29]
description = Bed leveling, not in use
gcode = 

[gcode_macro M900]
description = Linear Advance Factor, not in use
gcode = 

[led nombre_led]
red_pin = PB10
cycle_time = 0.010
initial_red = 1.0

[led tira_led]
white_pin = PA3
cycle_time = 0.010
initial_white = 0.6

[neopixel phoenix_led]
pin = PB0
chain_count = 8
color_order = GRB
initial_red = 0.5
initial_green = 0.1
initial_blue = 0.0

[gcode_macro _led_rainbow]
description = pone los colores del arco iris en los ocho leds neopixel
gcode = 
	
	
	
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.0 BLUE=0.05 INDEX=1
	
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.0 BLUE=0.0 INDEX=2
	
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.05 BLUE=0.0 INDEX=3
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.125 BLUE=0.0 INDEX=4
	
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.0 INDEX=5
	
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.0 BLUE=0.25 INDEX=6
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.0 BLUE=0.125 INDEX=7
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.125 BLUE=0.0 INDEX=8
	
	SET_LED LED=tira_led WHITE=0.2
	SET_LED LED=nombre_led RED=0.2
	
	M400

[gcode_macro led_capa]
description = Maneja las tiras de leds como indicadores de progreso de la impresión
gcode = 
	
	SET_LED LED=tira_led WHITE=0.01
	SET_LED LED=nombre_led RED=0.01
	
	
	{% set progreso = 0.0|float %}
	
	
	
	{% if printer.print_stats.state == "printing" %}
	
	
	{% set progreso = (printer.virtual_sdcard.progress * 100) |float %}
	
	{% endif %}
	
	
	
	
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.0 BLUE=0.0
	
	
	
	{% if progreso > 6.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=1
	{% endif %}
	
	{% if progreso > 12.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=1
	{% endif %}
	
	{% if progreso > 18.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=2
	{% endif %}
	
	{% if progreso > 24.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=2
	{% endif %}
	
	{% if progreso > 30.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=3
	{% endif %}
	
	{% if progreso > 36.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=3
	{% endif %}
	
	{% if progreso > 42.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=4
	{% endif %}
	
	{% if progreso > 48.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=4
	{% endif %}
	
	{% if progreso > 54.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=5
	{% endif %}
	
	{% if progreso > 60.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=5
	{% endif %}
	
	{% if progreso > 66.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=6
	{% endif %}
	
	{% if progreso > 72.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=6
	{% endif %}
	
	{% if progreso > 78.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=7
	{% endif %}
	
	{% if progreso > 84.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=7
	{% endif %}
	
	{% if progreso > 90.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=8
	{% endif %}
	
	{% if progreso > 96.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=8
	{% endif %}
	
	M400

[gcode_macro led_warning]
description = Enciende la señal de warning cinco iteraciones
gcode = 
	BEEP
	SET_LED LED=tira_led WHITE=0.0
	M400
	
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0
	
	_led_warning
	
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0

[gcode_macro _led_warning]
description = Enciende de rojo a rojo, pasando por carreras de color rojo sobre fondo azul y viceversa
gcode = 
	
	
	{% set repeticiones_led = 1  %}
	
	{% for repeticiones_led in range(7) %}
	
	
	{% set indice_baja = 1 %}
	
	{% for indice_baja in range(8) %}
	G4 P50
	{% set indice_baja = (1+indice_baja) %}
	SET_LED LED=phoenix_led RED=0.0  GREEN=0.0  BLUE=0.4  TRANSMIT=0
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0  INDEX={9-indice_baja}
	
	SET_LED LED=nombre_led RED=0.8
	
	{% endfor %}
	
	
	
	{% set indice_sube = 1 %}
	
	{% for indice_sube in range(8) %}
	G4 P50
	{% set indice_sube = (1+indice_sube) %}
	SET_LED LED=phoenix_led RED=0.4  GREEN=0.0  BLUE=0.0  TRANSMIT=0
	SET_LED LED=phoenix_led RED=0.0  GREEN=0.0  BLUE=1.0  INDEX={indice_sube}
	
	SET_LED LED=nombre_led RED=0.2
	
	{% endfor %}
	
	M400
	{% endfor %}

[gcode_macro led_apagar]
description = Pone a cero todos los leds
gcode = 
	BEEP
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.0 BLUE=0.0
	SET_LED LED=tira_led WHITE=0.0
	SET_LED LED=nombre_led RED=0.0

[gcode_macro _led_printing]
description = Pone la combinacion base de colores para imprimir
gcode = 
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.0 BLUE=0.0
	
	_LED_ABAJO
	SET_LED LED=tira_led WHITE=0.1
	SET_LED LED=nombre_led RED=0.2

[gcode_macro _led_atencion]
description = Pone la combinacion de colores de maquina no operativa
gcode = 
	_LED_NARANJA
	SET_LED LED=tira_led WHITE=0.01
	SET_LED LED=nombre_led RED=0.2

[gcode_macro _led_random]
description = Enciende luces de colores aleatorios en cada led
gcode = 
	{% set indice = 1  %}
	
	BEEP
	
	{% for indice in range(8) %}
	{% set rojo = (range(1,10) | random)/10 %}
	{% set verde = (range(1,10) | random)/10 %}
	{% set azul = (range(1,10) | random)/10 %}
	
	
	{% set indice = (1+indice) %}
	SET_LED LED=phoenix_led RED={rojo}  GREEN={verde}  BLUE={azul}  INDEX={indice}
	
	{% endfor %}

