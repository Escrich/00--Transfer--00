[gcode_macro led_capa]
description = Maneja las tiras de leds como indicadores de progreso de la impresión
gcode = 
	
	SET_LED LED=tira_led WHITE=0.01
	SET_LED LED=nombre_led RED=0.01
	
	
	{% set progreso = 0.0|float %}
	
	
	
	{% if printer.print_stats.state == "printing" %}
	
	
	{% set progreso = (printer.virtual_sdcard.progress * 100) |float %}
	
	{% endif %}
	
	
	
	
	SET_LED LED=phoenix_led RED=0.25 GREEN=0.0 BLUE=0.0
	
	
	
	{% if progreso > 6.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=1
	{% endif %}
	
	{% if progreso > 12.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=1
	{% endif %}
	
	{% if progreso > 18.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=2
	{% endif %}
	
	{% if progreso > 24.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=2
	{% endif %}
	
	{% if progreso > 30.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=3
	{% endif %}
	
	{% if progreso > 36.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=3
	{% endif %}
	
	{% if progreso > 42.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=4
	{% endif %}
	
	{% if progreso > 48.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=4
	{% endif %}
	
	{% if progreso > 54.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=5
	{% endif %}
	
	{% if progreso > 60.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=5
	{% endif %}
	
	{% if progreso > 66.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=6
	{% endif %}
	
	{% if progreso > 72.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=6
	{% endif %}
	
	{% if progreso > 78.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=7
	{% endif %}
	
	{% if progreso > 84.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=7
	{% endif %}
	
	{% if progreso > 90.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.25 INDEX=8
	{% endif %}
	
	{% if progreso > 96.0 %}
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.5 BLUE=0.0 INDEX=8
	{% endif %}
	
	M400

[gcode_macro led_warning]
description = Enciende la señal de warning cinco iteraciones
gcode = 
	BEEP
	SET_LED LED=tira_led WHITE=0.0
	M400
	
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0
	
	_led_warning
	
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0

[gcode_macro _led_warning]
description = Enciende de rojo a rojo, pasando por carreras de color rojo sobre fondo azul y viceversa
gcode = 
	
	
	{% set repeticiones_led = 1  %}
	
	{% for repeticiones_led in range(7) %}
	
	
	{% set indice_baja = 1 %}
	
	{% for indice_baja in range(8) %}
	G4 P50
	{% set indice_baja = (1+indice_baja) %}
	SET_LED LED=phoenix_led RED=0.0  GREEN=0.0  BLUE=0.4  TRANSMIT=0
	SET_LED LED=phoenix_led RED=1.0  GREEN=0.0  BLUE=0.0  INDEX={9-indice_baja}
	
	SET_LED LED=nombre_led RED=0.8
	
	{% endfor %}
	
	
	
	{% set indice_sube = 1 %}
	
	{% for indice_sube in range(8) %}
	G4 P50
	{% set indice_sube = (1+indice_sube) %}
	SET_LED LED=phoenix_led RED=0.4  GREEN=0.0  BLUE=0.0  TRANSMIT=0
	SET_LED LED=phoenix_led RED=0.0  GREEN=0.0  BLUE=1.0  INDEX={indice_sube}
	
	SET_LED LED=nombre_led RED=0.2
	
	{% endfor %}
	
	M400
	{% endfor %}

[gcode_macro led_apagar]
description = Pone a cero todos los leds
gcode = 
	BEEP
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.0 BLUE=0.0
	SET_LED LED=tira_led WHITE=0.0
