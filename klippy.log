	SET_LED LED=phoenix_led RED=0.25 GREEN=0.05 BLUE=0.0 INDEX=3
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.125 BLUE=0.0 INDEX=4
	
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.25 BLUE=0.0 INDEX=5
	
	SET_LED LED=phoenix_led RED=0.0 GREEN=0.0 BLUE=0.25 INDEX=6
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.0 BLUE=0.125 INDEX=7
	
	SET_LED LED=phoenix_led RED=0.125 GREEN=0.125 BLUE=0.0 INDEX=8
	
