[exclude_object]

[print_stats]

[gcode_arcs]
resolution = 0.1

[save_variables]
filename = ~/printer_data/config/variables/variables.cfg

[mcu]
serial = /dev/ttyS2
restart_method = command
baud = 115200

[stepper_x]
step_pin = PF13
dir_pin = PF12
enable_pin = !PF14
microsteps = 16
rotation_distance = 40.3969599
endstop_pin = tmc2209_stepper_x:virtual_endstop
position_endstop = 2.0
