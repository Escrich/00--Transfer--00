	300.0,117.5
points = 
	35,107.5
	35,117.5
	35,127.5
	233,127.5
	233,117.5
	233,107.5
speed = 100
horizontal_move_z = 3
retries = 3
retry_tolerance = 0.8

[gcode_macro G28]
description = Cambia el gcode original G28, auto home, y le añade sonidos y efectos luminosos
rename_existing = G28.1
